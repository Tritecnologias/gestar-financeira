# Deny by default: private local outputs never enter any build layer.
**
!package.json
!package-lock.json
!next.config.ts
!tsconfig.json
!eslint.config.mjs
!prisma.config.ts
!src/
!src/**
!public/
!public/**
!prisma/
!prisma/schema.prisma
!prisma/migrations/
!prisma/migrations/**
!prisma/production-migrations/
!prisma/production-migrations/**
!scripts/
!scripts/secure-build/
!scripts/secure-build/**
!scripts/access2/
!scripts/access2/analysis.mjs
!scripts/access3b/
!scripts/access3b/analysis.mjs
!tests/
!tests/**
# Defense in depth even inside allowed directories.
**/.git
**/node_modules
**/.next
**/.private
**/.env*
**/*.log
**/*.dump
**/*.bak
**/*.backup
**/*.pem
**/*.key
**/*.p12
**/*credentials*
**/*backup*
# Recovery implementation is source code, never backup payload. Exact code-only exceptions.
!src/lib/backup/
!src/lib/backup/*.mjs
!src/lib/backup-service.ts
!src/components/backup/
!src/components/backup/BackupClient.tsx
!src/app/api/backups/
!src/app/api/backups/route.ts
!src/app/(app)/backups/
!src/app/(app)/backups/page.tsx
!tests/backup-format.test.mjs
**/*audit-macro*
**/*.tmp
**/*.tsbuildinfo
