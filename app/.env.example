# Variáveis de Ambiente - Dez Soluções
# COPIE ESTE ARQUIVO PARA .env.local E PREENCHA OS VALORES

# ── Banco de Dados (PostgreSQL via Docker) ────────────────────
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5433/gestar_financeira"

# ── NextAuth.js ───────────────────────────────────────────────
# Gere um secret seguro com: openssl rand -base64 32
NEXTAUTH_SECRET="TROQUE_POR_UM_SECRET_SEGURO_32_CHARS"
NEXTAUTH_URL="http://localhost:3000"

# ── Convites por e-mail (DEV: mock, sem envio real) ──────────
EMAIL_PROVIDER="mock"
APP_PUBLIC_URL="http://localhost:3000"
# Para envio real futuro, use EMAIL_PROVIDER="smtp" e configure os campos abaixo
# em .env.local ou no gerenciador seguro do ambiente. Nunca commitar credenciais.
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_SECURE="true"
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM_ADDRESS=""
# EMAIL_FROM_NAME="10S · Dez Soluções"
# ACCESS_INVITE_HOURS="72"

# ── Em produção (VPS), altere para: ──────────────────────────
# NEXTAUTH_URL="https://seudominio.com.br"
# DATABASE_URL="postgresql://USUARIO:SENHA@postgres:5432/gestar_financeira"
# (note: em Docker Compose, o host é o nome do serviço "postgres", não "localhost")
