# Runtime only. This example DOES NOT authorize or activate a production release.
# Build the reviewed image with --build-arg DEPLOYMENT_PROFILE=production.
DEPLOYMENT_PROFILE=production
SPECIAL_INVITATIONS_ENABLED=false
SPECIAL_INVITATIONS_PRODUCTION_APPROVED=false
# Provision these values only through the approved private runtime secret store.
SPECIAL_INVITATION_LINK_KEY_ID=prod-special-v1
# SPECIAL_INVITATION_LINK_KEYS=<private JSON keyring; never commit a real key>
# Preserve the existing production DATABASE_URL, auth secrets, backup signing keys,
# origins and private mounts. Never copy HOMOLOG data, keys or configuration.
